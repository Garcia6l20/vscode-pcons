{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"@cmt/diagnostics/*": ["./deps/cmake-tools/src/diagnostics/*"],
			"@cmt/util": ["./src/shims/cmt-util"]
		}
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"old-src",
		"dist",
		"node_modules",
		"out"
	]
}
