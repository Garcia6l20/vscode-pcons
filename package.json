{
  "name": "pcons",
  "displayName": "pcons",
  "description": "pcons support for VSCode",
  "icon": "images/icon.png",
  "version": "0.0.5",
  "repository": {
    "url": "https://github.com/Garcia6l20/vscode-pcons"
  },
  "publisher": "garcia6l20",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:pcons-build.py"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pcons.generate",
        "title": "pcons: Generate"
      },
      {
        "command": "pcons.build",
        "title": "pcons: Build"
      },
      {
        "command": "pcons.run",
        "title": "pcons: Run"
      },
      {
        "command": "pcons.debug",
        "title": "pcons: Debug"
      },
      {
        "command": "pcons.debugGenerate",
        "title": "pcons: Debug Generate"
      },
      {
        "command": "pcons.clean",
        "title": "pcons: Clean"
      },
      {
        "command": "pcons.test",
        "title": "pcons: Test"
      },
      {
        "command": "pcons.selectLaunchTarget",
        "title": "pcons: Select Launch Target"
      },
      {
        "command": "pcons.selectBuildTargets",
        "title": "pcons: Select Build Targets"
      },
      {
        "command": "pcons.selectVariant",
        "title": "pcons: Select Variant"
      },
      {
        "command": "pcons.selectTestTargets",
        "title": "pcons: Select Test Targets"
      },
      {
        "command": "pcons.executableArguments",
        "title": "pcons: Set Executable Arguments"
      },
      {
        "command": "pcons.debugWithArgs",
        "title": "pcons: Debug With Arguments"
      },
      {
        "command": "pcons.commandDebug",
        "title": "pcons: Debug pcons Command"
      },
      {
        "command": "pcons.clearDiags",
        "title": "pcons: Clear Diagnostics"
      },
      {
        "command": "pcons.buildTarget",
        "title": "pcons: Build Target"
      },
      {
        "command": "pcons.runTarget",
        "title": "pcons: Run Target"
      },
      {
        "command": "pcons.debugTarget",
        "title": "pcons: Debug Target"
      },
      {
        "command": "pcons.toggleAdvancedCodeLensMode",
        "title": "pcons: Toggle Advanced CodeLens Mode"
      }
    ],
    "configuration": {
      "title": "pcons build configuration",
      "properties": {
        "pcons.buildFolder": {
          "type": "string",
          "default": "build",
          "description": "Specify in which folder pcons build configure and build the project."
        },
        "pcons.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Specify the python executable to use"
        },
        "pcons.debuggerPath": {
          "type": "string",
          "description": "Specify the debugger executable to use",
          "default": null
        },
        "pcons.jobs": {
          "type": "integer",
          "description": "Max parallel jobs"
        },
        "pcons.pythonDebugJustMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Use 'JustMyCode' option when debugging build scripts"
        },
        "pcons.variants": {
          "type": "array",
          "default": [
            "debug",
            "release"
          ],
          "description": "Available build variants. The first one will be used as default."
        },
        "pcons.variables": {
          "type": "object",
          "default": {},
          "description": "Workspace build variables"
        }
      }
    },
    "keybindings": [
      {
        "key": "f7",
        "when": "inPconsProject",
        "command": "pcons.build"
      },
      {
        "key": "ctrl+shift+f7",
        "when": "inPconsProject",
        "command": "pcons.debugGenerate"
      },
      {
        "key": "ctrl+f7",
        "when": "inPconsProject",
        "command": "pcons.clean"
      },
      {
        "key": "f5",
        "command": "pcons.debug",
        "when": "!inDebugMode && inPconsProject"
      },
      {
        "key": "ctrl+f5",
        "command": "pcons.debugWithArgs",
        "when": "!inDebugMode && inPconsProject"
      },
      {
        "key": "shift+f5",
        "command": "pcons.run",
        "when": "!inDebugMode && inPconsProject"
      },
      {
        "key": "ctrl+shift+f5",
        "command": "pcons.commandDebug",
        "when": "!inDebugMode && inPconsProject"
      },
      {
        "command": "pcons.toggleAdvancedCodeLensMode",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus && inPconsProject"
      }
    ],
    "menus": {
      "touchBar": [
        {
          "command": "pcons.selectLaunchTarget",
          "when": "inPconsProject",
          "group": "pcons:build"
        },
        {
          "command": "pcons.selectBuildTargets",
          "when": "inPconsProject",
          "group": "pcons:build"
        },
        {
          "command": "pcons.selectVariant",
          "when": "inPconsProject",
          "group": "pcons:build"
        },
        {
          "command": "pcons.build",
          "when": "inPconsProject",
          "group": "pcons:build"
        },
        {
          "command": "pcons.run",
          "when": "inPconsProject",
          "group": "pcons:run"
        },
        {
          "command": "pcons.debug",
          "when": "inPconsProject",
          "group": "pcons:run"
        },
        {
          "command": "pcons.clearDiags",
          "when": "inPconsProject",
          "group": "pcons:utils"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:prod",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile:prod": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "install:vsix": "vsce package -o pcons.vsix && code --install-extension pcons.vsix --force",
    "publish": "vsce publish",
    "update:vendored": "node scripts/update-vendored-diagnostics.mjs"
  },
  "dependencies": {
    "vscode-cpptools": "^5.0.0",
    "vscode-test-adapter-api": "^1.9.0",
    "vscode-test-adapter-util": "^0.7.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/shell-quote": "^1.7.3",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "extensionDependencies": [
    "hbenl.vscode-test-explorer"
  ]
}
